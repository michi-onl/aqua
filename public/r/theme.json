{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Aqua Theme",
  "description": "Mac OS X era palette and typography for shadcn/ui projects.",
  "cssVars": {
    "theme": {
      "font-sans": "'Lucida Grande', 'Lucida Sans Unicode', 'Helvetica Neue', Verdana, sans-serif"
    },
    "light": {
      "background": "#eef0f3",
      "foreground": "#33383f",
      "card": "#f7f8fa",
      "card-foreground": "#33383f",
      "popover": "#f7f8fa",
      "popover-foreground": "#33383f",
      "primary": "#2f7de0",
      "primary-foreground": "#ffffff",
      "secondary": "#e4e7ec",
      "secondary-foreground": "#3a3f47",
      "muted": "#e4e7ec",
      "muted-foreground": "#7a8089",
      "accent": "#d5e6fb",
      "accent-foreground": "#1c5fb8",
      "destructive": "#e03a2f",
      "border": "#7a7f88",
      "input": "#7a7f88",
      "ring": "#2f7de0"
    },
    "dark": {
      "background": "#1c1f24",
      "foreground": "#d7dae0",
      "card": "#23262c",
      "card-foreground": "#d7dae0",
      "popover": "#23262c",
      "popover-foreground": "#d7dae0",
      "primary": "#2f7de0",
      "primary-foreground": "#ffffff",
      "secondary": "#2a2e35",
      "secondary-foreground": "#d7dae0",
      "muted": "#2a2e35",
      "muted-foreground": "#8a909a",
      "accent": "#2d3540",
      "accent-foreground": "#7db9f5",
      "destructive": "#f2604d",
      "border": "#3a3f47",
      "input": "#4a5058",
      "ring": "#2f7de0"
    }
  },
  "css": {
    ":root": {
      "--aqua-accent": "#2f7de0",
      "--aqua-text": "#33383f",
      "--aqua-text-heading": "#23272e",
      "--aqua-text-secondary": "#5a6069",
      "--aqua-text-muted": "#7a8089",
      "--aqua-text-subtle": "#9aa0aa",
      "--aqua-link": "#1c5fb8",
      "--aqua-border-strong": "#8b909a",
      "--aqua-border": "#aeb3bc",
      "--aqua-border-light": "#d2d5da",
      "--aqua-surface": "#ffffff",
      "--aqua-surface-2": "#f4f5f8",
      "--aqua-surface-3": "#eceef2",
      "--aqua-sidebar": "#dde4ed",
      "--aqua-row-alt": "#edf3fd",
      "--aqua-row-hover": "#e0eafa",
      "--aqua-drop-shadow": "rgba(20, 60, 130, 0.2)",
      "--aqua-inset": "rgba(255, 255, 255, 0.9)",
      "--aqua-groove": "#d7dbe2",
      "--aqua-dock-border": "rgba(255, 255, 255, 0.9)",
      "--aqua-surface-silver": "linear-gradient(180deg,#ffffff 0%,#e9ecf0 20%,#c9cdd4 46%,#ced2d9 54%,#eef0f3 74%,#ffffff 100%)",
      "--aqua-surface-white": "linear-gradient(180deg,#ffffff 0%,#f6f7fa 100%)",
      "--aqua-surface-metal": "linear-gradient(180deg,#fdfdfe 0%,#e4e7ec 48%,#d3d7de 52%,#eceef2 100%)",
      "--aqua-surface-menubar": "linear-gradient(180deg,#fdfdfe 0%,#eceef2 48%,#e0e3e9 52%,#eff1f5 100%)",
      "--aqua-surface-drawer": "linear-gradient(180deg,#eef0f4 0%,#dfe2e8 100%)",
      "--aqua-surface-window": "linear-gradient(180deg,#d9dbde 0%,#c3c6ca 100%)",
      "--aqua-surface-sheet": "linear-gradient(180deg,#fbfbfc 0%,#eceef2 100%)",
      "--aqua-surface-nav": "linear-gradient(180deg,#fbfcfd 0%,#e8ebef 55%,#dcdfe4 100%)",
      "--aqua-surface-stripes": "repeating-linear-gradient(180deg,#f4f6fa 0px,#f4f6fa 2px,#eaeef4 2px,#eaeef4 4px)",
      "--aqua-surface-skeleton": "linear-gradient(180deg,#f4f6f9 0%,#e7eaef 50%,#e0e3e9 51%,#eef0f4 100%)",
      "--aqua-surface-shell": "linear-gradient(160deg,#ffffff 0%,#eceef2 55%,#d8dbe1 100%)",
      "--aqua-surface-dock": "linear-gradient(180deg,rgba(255,255,255,0.55) 0%,rgba(235,238,243,0.75) 100%)"
    },
    "*, *::before, *::after": {
      "--aqua-gel-hi": "color-mix(in oklab, var(--aqua-accent) 38%, white)",
      "--aqua-gel-light": "color-mix(in oklab, var(--aqua-accent) 62%, white)",
      "--aqua-gel-mid": "color-mix(in oklab, var(--aqua-accent) 90%, white)",
      "--aqua-gel-deep": "color-mix(in oklab, var(--aqua-accent) 85%, black)",
      "--aqua-edge": "color-mix(in oklab, var(--aqua-accent) 72%, black)",
      "--aqua-ring": "var(--ring)"
    },
    ".dark": {
      "--aqua-text": "#d7dae0",
      "--aqua-text-heading": "#eef0f3",
      "--aqua-text-secondary": "#a6acb5",
      "--aqua-text-muted": "#8a909a",
      "--aqua-text-subtle": "#6b717a",
      "--aqua-link": "#7db9f5",
      "--aqua-border-strong": "#4a5058",
      "--aqua-border": "#3a3f47",
      "--aqua-border-light": "#30353c",
      "--aqua-surface": "#1c1f24",
      "--aqua-surface-2": "#23262c",
      "--aqua-surface-3": "#2a2e35",
      "--aqua-sidebar": "#22262d",
      "--aqua-row-alt": "#242932",
      "--aqua-row-hover": "#2d3540",
      "--aqua-drop-shadow": "rgba(0, 0, 0, 0.55)",
      "--aqua-inset": "rgba(255, 255, 255, 0.08)",
      "--aqua-groove": "#33383f",
      "--aqua-dock-border": "rgba(255, 255, 255, 0.15)",
      "--aqua-surface-silver": "linear-gradient(180deg,#3a3f47 0%,#2e333a 20%,#262b32 46%,#292e35 54%,#33383f 74%,#3a3f47 100%)",
      "--aqua-surface-white": "linear-gradient(180deg,#23262c 0%,#1c1f24 100%)",
      "--aqua-surface-metal": "linear-gradient(180deg,#2e333a 0%,#262b31 48%,#22262c 52%,#2a2f35 100%)",
      "--aqua-surface-menubar": "linear-gradient(180deg,#2e333a 0%,#282d33 48%,#24292f 52%,#2b3036 100%)",
      "--aqua-surface-drawer": "linear-gradient(180deg,#282d33 0%,#22262c 100%)",
      "--aqua-surface-window": "linear-gradient(180deg,#2e333a 0%,#22262c 100%)",
      "--aqua-surface-sheet": "linear-gradient(180deg,#2a2e35 0%,#23262c 100%)",
      "--aqua-surface-nav": "linear-gradient(180deg,#2e333a 0%,#262b31 55%,#20242a 100%)",
      "--aqua-surface-stripes": "repeating-linear-gradient(180deg,#22262c 0px,#22262c 2px,#1c1f24 2px,#1c1f24 4px)",
      "--aqua-surface-skeleton": "linear-gradient(180deg,#2a2e35 0%,#23262c 50%,#1f2329 51%,#2a2e35 100%)",
      "--aqua-surface-shell": "linear-gradient(160deg,#2a2e35 0%,#23262c 55%,#1a1d22 100%)",
      "--aqua-surface-dock": "linear-gradient(180deg,rgba(255,255,255,0.14) 0%,rgba(255,255,255,0.05) 100%)"
    },
    ".dark *, .dark *::before, .dark *::after": {
      "--aqua-gel-hi": "color-mix(in oklab, var(--aqua-accent) 55%, white)",
      "--aqua-gel-light": "color-mix(in oklab, var(--aqua-accent) 70%, #0e1013)",
      "--aqua-gel-mid": "color-mix(in oklab, var(--aqua-accent) 82%, #0e1013)",
      "--aqua-gel-deep": "color-mix(in oklab, var(--aqua-accent) 60%, black)",
      "--aqua-edge": "color-mix(in oklab, var(--aqua-accent) 45%, black)",
      "--aqua-ring": "var(--ring)"
    }
  },
  "type": "registry:theme"
}